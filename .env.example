# 当前默认：主模型与 local 均指向同一 OpenAI 兼容端点（密钥填在 .env，勿提交）
PRIMARY_LLM_BASE_URL=http://118.195.177.58:8001/v1
PRIMARY_LLM_API_KEY=
PRIMARY_LLM_MODEL=nemotron-3.5-lightning:30b-a3b-mlx-bf16
PRIMARY_LLM_PROVIDER_ID=local-nemotron
PRIMARY_LLM_LABEL=本地 Nemotron

LOCAL_LLM_BASE_URL=http://118.195.177.58:8001/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=nemotron-3.5-lightning:30b-a3b-mlx-bf16
LOCAL_LLM_PROVIDER_ID=local-nemotron
LOCAL_LLM_LABEL=本地 Nemotron

# OHLCV：本地 qlib 落后时自动从腾讯/东财/baostock 补洞（默认开启）
OHLCV_BACKFILL_ENABLED=true
OHLCV_BACKFILL_BAOSTOCK=true

# Embedding / RAG（OpenAI 兼容 /v1/embeddings；未设 EMBEDDING_API_KEY 时复用 PRIMARY_LLM_API_KEY）
EMBEDDING_ENABLED=true
EMBEDDING_BASE_URL=http://118.195.177.58:8001/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding:8b
EMBEDDING_DIMENSIONS=1024

# Reranker（/rerank 或 /v1/rerank；不可用时回退 embedding 余弦）
RERANKER_ENABLED=true
RERANKER_MODEL=awenleven/Qwen3-Reranker-4B:Q4_K_M

# 知识归档
KNOWLEDGE_ARCHIVE_ENABLED=true
KNOWLEDGE_DEDUP_BY_HASH=true

# 知识图谱（R3）
GRAPH_ENABLED=true
GRAPH_FETCH_MIN_INTERVAL_S=3.0
GRAPH_SYNC_COOLDOWN_HOURS=6.0
GRAPH_SENTIMENT_LIMIT=5
GRAPH_ANNOUNCEMENT_LIMIT=8
GRAPH_ANNOUNCEMENT_DAYS=90
GRAPH_ROLLUP_LLM_ENABLED=true
GRAPH_SYNC_SAMPLE_SYMBOLS=sh600519,sh601318,sz000858,sh600036,sz300750

# 政策 URL 抓取（白名单见 data/policy_sources.yaml）
POLICY_FETCH_MIN_INTERVAL_S=2.0
POLICY_FETCH_TIMEOUT_S=30.0
POLICY_SYNC_MAX_PER_RUN=5

# 图谱扩展
GRAPH_EXTRACT_TRIPLES_ENABLED=true
GRAPH_JSONL_ROTATE_ENABLED=true
GRAPH_SCHEDULER_ENABLED=true
GRAPH_SCHEDULER_ON_STARTUP=false

# 上下文压缩：历史步骤估算 token 超过此值时触发 CompactionEngine（默认 128k）
CONTEXT_COMPACT_THRESHOLD_TOKENS=128000
